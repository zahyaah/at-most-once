PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=warehouse
DB_PASSWORD=
DB_NAME=warehouse
DB_POOL_SIZE=100
LOG_LEVEL=warn
DB_LEASE_POOL_SIZE=5
# Comma-separated browser origins allowed to call this API. Empty means same-origin only,
# which is what local development wants.
CORS_ALLOWED_ORIGINS=
# Set true against a managed provider such as Aiven, which requires TLS. The local container
# does not serve TLS, so leave it false for development.
DB_SSL=false
# Paste the provider's CA certificate here when DB_SSL is true.
DB_SSL_CA=
